# ============================================================
# e-oficinas - exemplo de variaveis (.env)
# Copie para .env e preencha. No Coolify, cadastre estas
# variaveis em Resources -> seu app -> Environment Variables.
# ============================================================

# --- Django ---
DJANGO_SECRET_KEY=troque-por-uma-chave-secreta-larga-e-aleatoria
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=eoficinas.ivcsofthouse.com.br
DJANGO_CSRF_TRUSTED_ORIGINS=https://eoficinas.ivcsofthouse.com.br

# --- Banco de dados (MySQL 8 do proprio compose) ---
DB_NAME=eoficinas_db
DB_USER=eoficinas
DB_PASSWORD=troque-esta-senha-do-banco
DB_ROOT_PASSWORD=troque-esta-senha-root
DB_HOST=db
DB_PORT=3306
DB_WAIT_SECONDS=60

# --- Gunicorn ---
PORT=8000
GUNICORN_WORKERS=3
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=120

# --- Superusuario do Django admin (opcional; criado 1x no primeiro boot) ---
# DJANGO_SUPERUSER_USERNAME=admin
# DJANGO_SUPERUSER_EMAIL=admin@ivcsofthouse.com.br
# DJANGO_SUPERUSER_PASSWORD=uma-senha-forte
